{
  "$defs": {
    "ChangeRef": {
      "description": "Identifies one change (commit or PR) in one repository.",
      "properties": {
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "org_id": {
          "title": "Org Id",
          "type": "string"
        },
        "pr_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pr Number"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        }
      },
      "required": [
        "org_id",
        "repo",
        "commit_sha"
      ],
      "title": "ChangeRef",
      "type": "object"
    }
  },
  "description": "A failure was confirmed as a bug and stored in bug memory.",
  "properties": {
    "bug_id": {
      "title": "Bug Id",
      "type": "string"
    },
    "change": {
      "$ref": "#/$defs/ChangeRef"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "fingerprint": {
      "title": "Fingerprint",
      "type": "string"
    },
    "module": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Module"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "type": {
      "const": "bug.confirmed",
      "default": "bug.confirmed",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "change",
    "bug_id",
    "fingerprint"
  ],
  "title": "BugConfirmed",
  "type": "object"
}

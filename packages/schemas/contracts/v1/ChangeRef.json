{
  "description": "Identifies one change (commit or PR) in one repository.",
  "properties": {
    "commit_sha": {
      "title": "Commit Sha",
      "type": "string"
    },
    "org_id": {
      "title": "Org Id",
      "type": "string"
    },
    "pr_number": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pr Number"
    },
    "repo": {
      "title": "Repo",
      "type": "string"
    }
  },
  "required": [
    "org_id",
    "repo",
    "commit_sha"
  ],
  "title": "ChangeRef",
  "type": "object"
}

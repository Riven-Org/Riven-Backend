{
  "$defs": {
    "ChangeRef": {
      "description": "Identifies one change (commit or PR) in one repository.",
      "properties": {
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "org_id": {
          "title": "Org Id",
          "type": "string"
        },
        "pr_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pr Number"
        },
        "repo": {
          "title": "Repo",
          "type": "string"
        }
      },
      "required": [
        "org_id",
        "repo",
        "commit_sha"
      ],
      "title": "ChangeRef",
      "type": "object"
    },
    "VerificationStatus": {
      "enum": [
        "passed",
        "failed",
        "needs_review"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "description": "A verification run finished with a verdict from an independent verifier.",
  "properties": {
    "change": {
      "$ref": "#/$defs/ChangeRef"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/VerificationStatus"
    },
    "type": {
      "const": "verification.completed",
      "default": "verification.completed",
      "title": "Type",
      "type": "string"
    },
    "verifier_identity": {
      "title": "Verifier Identity",
      "type": "string"
    }
  },
  "required": [
    "change",
    "run_id",
    "status",
    "verifier_identity"
  ],
  "title": "VerificationCompleted",
  "type": "object"
}

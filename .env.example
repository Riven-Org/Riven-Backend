# Copy to .env for local development. Never commit .env.
RIVEN_ENV=dev
RIVEN_DATABASE_URL=postgresql+asyncpg://riven:riven@localhost:5432/riven
RIVEN_REDIS_URL=redis://localhost:6379/0
RIVEN_TEMPORAL_ADDRESS=localhost:7233
RIVEN_TEMPORAL_NAMESPACE=default
RIVEN_OUTBOX_POLL_SECONDS=0.5
# Tests: point at a disposable database to run the Postgres-backed tests locally.
# RIVEN_TEST_DATABASE_URL=postgresql+asyncpg://riven:riven@localhost:5432/riven_test

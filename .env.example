# Copy to .env for local development. Never commit .env.
# RIVEN_ENV: dev | test | staging | prod. Staging/prod refuse the development JWT secret.
RIVEN_ENV=dev
# SQLite file in the working directory; tables are created when the API starts.
RIVEN_DATABASE_URL=sqlite+aiosqlite:///./riven.db
# Signs login tokens. Use a long random value outside development.
RIVEN_JWT_SECRET=riven-dev-secret-change-me-in-production
RIVEN_JWT_TTL_MINUTES=1440

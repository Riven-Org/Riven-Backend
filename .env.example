# Copy to .env for local development. Never commit .env.
# RIVEN_ENV: dev | test | staging | prod. Staging/prod refuse the development credentials below.
RIVEN_ENV=dev
# Optional: directory of secret files (e.g. /run/secrets); file `riven_database_url` sets
# RIVEN_DATABASE_URL. Environment variables win over files. See docs/adr/0012.
# RIVEN_SECRETS_DIR=/run/secrets
RIVEN_DATABASE_URL=postgresql+asyncpg://riven:riven@localhost:5432/riven
RIVEN_REDIS_URL=redis://localhost:6379/0
RIVEN_TEMPORAL_ADDRESS=localhost:7233
RIVEN_TEMPORAL_NAMESPACE=default
RIVEN_OUTBOX_POLL_SECONDS=0.5
# Object storage (SeaweedFS from docker-compose; S3 in the cloud: leave the endpoint empty)
RIVEN_S3_ENDPOINT_URL=http://localhost:9000
RIVEN_S3_BUCKET=riven-artifacts
RIVEN_S3_ACCESS_KEY=riven
RIVEN_S3_SECRET_KEY=riven-dev-secret
# Tests: point at a disposable database to run the Postgres-backed tests locally.
# RIVEN_TEST_DATABASE_URL=postgresql+asyncpg://riven:riven@localhost:5432/riven_test
# Identity provider (Keycloak, see infra/keycloak). The issuer must match the token `iss`.
RIVEN_OIDC_ISSUER=http://localhost:8081/realms/riven
RIVEN_OIDC_AUDIENCE=riven-api
# Only when the API reaches Keycloak on another hostname than the browser does:
# RIVEN_OIDC_JWKS_URL_OVERRIDE=http://keycloak:8080/realms/riven/protocol/openid-connect/certs
